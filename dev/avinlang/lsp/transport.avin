module dev.avinlang.lsp

// The connections an editor starts a server on, named by the arguments it passes: `--stdio`, the
// process's own standard input and output, `--pipe=<path>`, a Unix domain socket the client listens
// on, and `--socket=<port>`, a TCP port on the local host the client listens on. The server serves
// that connection until `exit`, or until its input ends.
import avin.io.IoError
import avin.net.{StreamReader, StreamWriter, TcpStream, UnixStream}

// Where to serve, from a server's arguments: `--stdio`, `--pipe=<path>` or `--pipe <path>`,
// `--socket=<port>` or `--socket <port>` (also spelt `--port`); where several are given the last one
// counts, where none is given it is `Stdio`, and `--clientProcessId` and any other argument is passed
// over. `Err` says what is wrong.
data Connection
  Stdio
  Pipe(path: string)
  Socket(port: int)

connectionOf(args: Vector[string]) -> Result[Connection, string]
  var found: Option[Connection] = None
  var i = 0
  while i < args.length
    val arg = args(i)
    val (name, value) = if arg.contains("=") then (
      arg.slice(0, arg.indexOf("=")),
      Some(arg.slice(arg.indexOf("=") + 1, arg.byteLength))
    ) else (arg, None)
    if arg == "--stdio"
      found = Some(Stdio)
    elif name == "--pipe" || name == "--socket" || name == "--port"
      val given = value match
        Some(v) -> v
        None ->
          i += 1
          if i >= args.length then return Err(s"$name names nothing")
          args(i)
      found = if name == "--pipe" then Some(Pipe(given)) else given.toIntOption() match
        Some(port) if 0 < port < 65536 -> Some(Socket(port))
        _ -> return Err(s"'$given' is not a port")
    i += 1
  Ok(found.getOrElse(Stdio))

// The Unix domain socket at `path` connected, as its reading and writing halves.
private connectPipe(path: string) -> Result[(StreamReader, StreamWriter), IoError] =
  UnixStream.connect(path).map(s -> s.split())

// The TCP port `port` on the local host connected, as its reading and writing halves.
private connectSocket(port: int) -> Result[(StreamReader, StreamWriter), IoError] =
  TcpStream.connect("127.0.0.1", port).map(s -> s.split())
