module dev.avinlang.lsp

// A language server: the handlers a program registers, and `serve`, which reads messages, keeps the
// lifecycle and the open documents, and answers each request on a lightweight thread of its own.
import avin.io
import avin.io.{ByteWriter, Reader}
import avin.threads.{Atomic, Channel, Mutex, spawn}
import dev.avinlang.json
import dev.avinlang.json.{Json, JsonDecoder, JsonEncoder}

// A request's handler with its params' and result's types erased: it reads its params from the
// message, parsed once, and gives its result written as JSON.
private data Route(run: @sendable (Context, Json) -> Result[string, ResponseError])

// A notification's handler, its params' type erased likewise.
private data NotificationRoute(run: @sendable (Context, Json) -> unit)

// What a document's diagnostics are found by.
private data Diagnoser(run: @sendable (Context, TextDocument) -> Vector[Diagnostic])

// A request being answered: whether it has been cancelled, and whether its answer has gone, the
// handler's or the cancellation's, whichever came first.
private data Pending(cancelled: Atomic[bool], answered: Atomic[bool])

private data CancelParams(id: RequestId) derives JsonDecoder

// What the editor is told the server is, and how it is reached: the handlers registered, each typed
// by its params and its result. A handler answers a `Result`, its `Err` the error the request is
// answered with. The capabilities announced at `initialize` are those of the handlers registered.
//
//     val server = Server("toy", "0.1")
//       .onDiagnostics((ctx, doc) -> check(doc))
//       .onHover((ctx, p) -> Ok(hoverAt(ctx, p)))
//     exit(server.serve(input, output))
class Server(val name: string, val version: string = "")
  private var routes: HashMap[string, Route] = HashMap.empty[string, Route]()
  private var notes: HashMap[string, NotificationRoute] = HashMap.empty[string, NotificationRoute]()
  private var diagnoser: Option[Diagnoser] = None
  private var provides: Vector[(string, Json)] = []

  // `handler` answers requests of `method`, its params read as a `P` and its result written from an
  // `R`. A method no handler is registered for is answered `MethodNotFound`; params that do not read
  // as a `P` are answered `InvalidParams`, naming what is wrong.
  onRequest[P: JsonDecoder, R: JsonEncoder](
      method: string,
      handler: @sendable (Context, P) -> Result[R, ResponseError]
  ) -> Server
    routes = routes.updated(method, Route((ctx, message) -> json.decode[Params[P]](message) match
      Err(e) -> Err(ResponseError(InvalidParams, e.toString()))
      Ok(p) -> handler(ctx, p.params).map(r -> json.encode(r, omitNone = true))))
    self

  // `handler` is told of notifications of `method`, in the order they arrive, before anything after
  // them is read; params that do not read as a `P` are passed over.
  onNotification[P: JsonDecoder](method: string, handler: @sendable (Context, P) -> unit) -> Server
    notes = notes.updated(method, NotificationRoute((ctx, message) -> json.decode[Params[P]](message) match
      Ok(p) -> handler(ctx, p.params)
      Err(_) -> ()))
    self

  // `find` gives a document's diagnostics, each time it is opened or changed, published as
  // `textDocument/publishDiagnostics` once found, unless the document has changed or closed since;
  // a document closed has its diagnostics cleared.
  onDiagnostics(find: @sendable (Context, TextDocument) -> Vector[Diagnostic]) -> Server
    diagnoser = Some(Diagnoser(find))
    self

  onHover(handler: @sendable (Context, TextDocumentPositionParams) -> Result[Option[Hover], ResponseError]) -> Server =
    provided("hoverProvider", Json.Bool(true)).onRequest("textDocument/hover", handler)

  // Completion, with the characters that ask for it as they are typed.
  onCompletion(
      handler: @sendable (Context, CompletionParams) -> Result[CompletionList, ResponseError],
      triggerCharacters: Vector[string] = []
  ) -> Server =
    val options = if triggerCharacters.isEmpty then Json.obj() else Json.obj(
      ("triggerCharacters", Json.Arr(triggerCharacters.map(c -> Json.str(c))))
    )
    provided("completionProvider", options).onRequest("textDocument/completion", handler)

  onDefinition(
      handler: @sendable (Context, TextDocumentPositionParams) -> Result[Vector[Location], ResponseError]
  ) -> Server =
    provided("definitionProvider", Json.Bool(true)).onRequest("textDocument/definition", handler)

  onReferences(handler: @sendable (Context, ReferenceParams) -> Result[Vector[Location], ResponseError]) -> Server =
    provided("referencesProvider", Json.Bool(true)).onRequest("textDocument/references", handler)

  onDocumentSymbols(
      handler: @sendable (Context, DocumentSymbolParams) -> Result[Vector[DocumentSymbol], ResponseError]
  ) -> Server =
    provided("documentSymbolProvider", Json.Bool(true)).onRequest("textDocument/documentSymbol", handler)

  onFormatting(
      handler: @sendable (Context, DocumentFormattingParams) -> Result[Vector[TextEdit], ResponseError]
  ) -> Server =
    provided("documentFormattingProvider", Json.Bool(true)).onRequest("textDocument/formatting", handler)

  onRename(handler: @sendable (Context, RenameParams) -> Result[Option[WorkspaceEdit], ResponseError]) -> Server =
    provided("renameProvider", Json.Bool(true)).onRequest("textDocument/rename", handler)

  // Semantic tokens of a whole document, of the types and modifiers `legend` names.
  onSemanticTokens(
      legend: SemanticTokensLegend,
      handler: @sendable (Context, SemanticTokensParams) -> Result[SemanticTokens, ResponseError]
  ) -> Server =
    val names = (all: Vector[string]) -> Json.Arr(all.map(n -> Json.str(n)))
    val described = Json.obj(("tokenTypes", names(legend.tokenTypes)), ("tokenModifiers", names(legend.tokenModifiers)))
    val options = Json.obj(("legend", described), ("full", Json.Bool(true)))
    provided("semanticTokensProvider", options).onRequest("textDocument/semanticTokens/full", handler)

  // Reads messages from `input` and writes the answers to `output` until `exit`, and answers the
  // status the process ends with: 0 after `shutdown` and 1 without, and 1 where the input ends first
  // or its framing cannot be read, past which there is no telling where a message starts.
  serve[W: ByteWriter & Sendable](input: Reader, output: W, maxMessageBytes: int = defaultMaxMessageBytes) -> int
    val out = Channel[Option[string]]()
    val writer = spawn(() -> writeAll(out, output))
    val session = Session(name, version, routes, notes, diagnoser, provides, out)
    val reader = MessageReader(input, maxMessageBytes)
    var code = 1
    loop
      reader.next() match
        Err(e) ->
          eprintln(s"lsp: $e")
          break
        Ok(None) -> break
        Ok(Some(Err(why))) -> session.send(
          errorText(None, ResponseError(ParseError, s"the message is not UTF-8: $why"))
        )
        Ok(Some(Ok(body))) ->
          session.receive(body)
          if session.exitCode is Some(c)
            code = c
            break
    out.send(None)
    writer.join()
    code

  // Connects where `args` say (`connectionOf`) and serves that connection, answering the status to
  // exit with: as `serve` answers it, or 2 where the arguments are wrong or the connection cannot be
  // made, said on standard error. With `--stdio`, or no connection named, the messages are the
  // process's own standard input and output, as bytes, and standard error is the only place left for
  // anything else: nothing but the server may write to standard output, `print` and `println`
  // included.
  serveArgs(args: Vector[string]) -> int
    val streams = connectionOf(args) match
      Err(why) ->
        eprintln(s"lsp: $why")
        return 2
      Ok(Stdio) -> return serve(io.stdin(), io.stdout())
      Ok(Pipe(path)) -> connectPipe(path)
      Ok(Socket(port)) -> connectSocket(port)
    streams match
      Err(e) ->
        eprintln(s"lsp: ${e.message}")
        2
      Ok((input, output)) ->
        val code = serve(input, output)
        _ = output.close()
        _ = input.close()
        code

  private provided(capability: string, value: Json) -> Server
    provides = provides.filter(p -> p.0 != capability) :+ (capability, value)
    self

// Writes each message sent on `out`, framed, until the `None` that ends them. A write that fails
// ends the writing; what is sent after is dropped.
private writeAll[W: ByteWriter & Sendable](out: Channel[Option[string]], output: W)
  var failed = false
  loop
    out.receive() match
      Some(Some(text)) ->
        if !failed && output.write(frame(text).utf8).isErr then failed = true
      _ -> break

// What one run of `serve` keeps between messages. Only the thread reading messages changes it, but
// for the open documents and the requests being answered, which handlers' threads read.
private class Session(
    val name: string,
    val version: string,
    val routes: HashMap[string, Route],
    val notes: HashMap[string, NotificationRoute],
    val diagnoser: Option[Diagnoser],
    val provides: Vector[(string, Json)],
    val out: Channel[Option[string]]
)
  var initialized = false
  var shutDown = false
  var exitCode: Option[int] = None
  var encoding: PositionEncoding = Utf16
  var client: InitializeParams = InitializeParams()
  val documents: Mutex[HashMap[string, TextDocument]] = Mutex(HashMap.empty[string, TextDocument]())
  val inFlight: Mutex[HashMap[RequestId, Pending]] = Mutex(HashMap.empty[RequestId, Pending]())

  send(text: string) = out.send(Some(text))

  // Answers one message's text.
  receive(body: string)
    if body.stripLeading.startsWith("[")
      send(errorText(None, ResponseError(InvalidRequest, "a batch of messages is not supported")))
      return
    val message = json.parse(body) match
      Ok(tree) -> tree
      Err(e) ->
        send(errorText(None, ResponseError(ParseError, e.toString())))
        return
    val head = json.decode[Head](message) match
      Ok(h) -> h
      Err(e) ->
        send(errorText(None, ResponseError(InvalidRequest, e.toString())))
        return
    if head.jsonrpc != Some("2.0")
      send(errorText(head.id, ResponseError(InvalidRequest, "a message is JSON-RPC 2.0, with \"jsonrpc\": \"2.0\"")))
      return
    val method = head.method match
      Some(m) -> m
      None ->
        // A response to something the server asked: it asks nothing, so there is nothing to do.
        if head.id.isEmpty || (head.result.isEmpty && head.error.isEmpty)
          send(errorText(head.id, ResponseError(InvalidRequest, "a request or a notification names a method")))
        return
    head.id match
      None -> notified(method, message)
      Some(id) -> requested(id, method, message)

  private requested(id: RequestId, method: string, message: Json)
    if method == "initialize"
      if initialized
        send(errorText(Some(id), ResponseError(InvalidRequest, "'initialize' was sent already")))
        return
      json.decode[Params[InitializeParams]](message) match
        Err(e) -> send(errorText(Some(id), ResponseError(InvalidParams, e.toString())))
        Ok(p) ->
          initialized = true
          client = p.params
          encoding = negotiate(client.capabilities.general.flatMap(g -> g.positionEncodings).getOrElse([]))
          val result = InitializeResult(
            capabilities(),
            ServerInfo(name, if version.isEmpty then None else Some(version))
          )
          send(responseText(id, json.encode(result, omitNone = true)))
      return
    if !initialized
      send(errorText(Some(id), ResponseError(ServerNotInitialized, s"'$method' before 'initialize'")))
      return
    if shutDown
      send(errorText(Some(id), ResponseError(InvalidRequest, s"'$method' after 'shutdown'")))
      return
    if method == "shutdown"
      shutDown = true
      send(responseText(id, "null"))
      return
    val route = routes.get(method) match
      Some(r) -> r
      None ->
        send(errorText(Some(id), ResponseError(MethodNotFound, s"'$method' is not a method this server answers")))
        return
    val pending = Pending(Atomic(false), Atomic(false))
    val previous = inFlight.with(m -> m.get(id))
    if previous.nonEmpty
      send(errorText(Some(id), ResponseError(InvalidRequest, s"request $id is already being answered")))
      return
    inFlight.update(m -> m.updated(id, pending))
    val token = json.decode[WithToken](message).toOption.flatMap(w -> w.params).flatMap(t -> t.workDoneToken)
    val ctx = context(pending.cancelled, token)
    val table = inFlight
    val output = out
    spawn(() ->
      val answer = route.run(ctx, message) match
        Ok(result) -> responseText(id, result)
        Err(error) -> errorText(Some(id), error)
      table.update(m -> m.removed(id))
      if pending.answered.compareAndSet(false, true) then output.send(Some(answer)))

  private notified(method: string, message: Json)
    if method == "exit"
      exitCode = Some(if shutDown then 0 else 1)
      return
    if !initialized || shutDown then return
    if method == "$/cancelRequest"
      json.decode[Params[CancelParams]](message) match
        Ok(p) -> cancel(p.params.id)
        Err(_) -> ()
    elif method == "textDocument/didOpen"
      json.decode[Params[DidOpenTextDocumentParams]](message) match
        Ok(p) ->
          val item = p.params.textDocument
          opened(TextDocument(item.uri, item.languageId, item.version, item.text))
        Err(_) -> ()
    elif method == "textDocument/didChange"
      json.decode[Params[DidChangeTextDocumentParams]](message) match
        Ok(p) -> changed(p.params)
        Err(_) -> ()
    elif method == "textDocument/didClose"
      json.decode[Params[DidCloseTextDocumentParams]](message) match
        Ok(p) -> closed(p.params.textDocument.uri)
        Err(_) -> ()
    else
      notes.get(method) match
        Some(n) -> n.run(context(Atomic(false), None), message)
        None -> ()

  // A cancellation: the request's handler is told, and the request is answered `RequestCancelled`
  // now unless its handler answered first. An id no request being answered has is passed over.
  private cancel(id: RequestId)
    val pending = inFlight.with(m -> m.get(id))
    pending match
      Some(p) ->
        p.cancelled.store(true)
        if p.answered.compareAndSet(false, true)
          send(errorText(Some(id), ResponseError(RequestCancelled, s"request $id was cancelled")))
      None -> ()

  private opened(doc: TextDocument)
    documents.update(m -> m.updated(doc.uri, doc))
    diagnose(doc)

  private changed(p: DidChangeTextDocumentParams)
    val uri = p.textDocument.uri
    val current = documents.with(m -> m.get(uri))
    current match
      Some(doc) ->
        var now = doc
        for change in p.contentChanges
          now = now.applying(change, p.textDocument.version, encoding)
        val made = TextDocument(uri, doc.languageId, p.textDocument.version, now.text)
        documents.update(m -> m.updated(uri, made))
        diagnose(made)
      None -> ()

  private closed(uri: string)
    documents.update(m -> m.removed(uri))
    if diagnoser.nonEmpty then send(
      notificationText("textDocument/publishDiagnostics", PublishDiagnosticsParams(uri, []))
    )

  // Finds `doc`'s diagnostics on a thread of their own and publishes them, unless by then the
  // document has changed or closed: the check and the sending are made holding the documents, so a
  // later version's diagnostics are never followed by an earlier one's.
  private diagnose(doc: TextDocument)
    val find = diagnoser match
      Some(d) -> d
      None -> return
    val ctx = context(Atomic(false), None)
    val docs = documents
    val output = out
    spawn(() ->
      val found = find.run(ctx, doc)
      val text = notificationText(
        "textDocument/publishDiagnostics",
        PublishDiagnosticsParams(doc.uri, found, Some(doc.version))
      )
      docs.with(m ->
        if m.get(doc.uri).exists(d -> d.version == doc.version && d.text == doc.text) then output.send(Some(text))))

  private capabilities() -> Json
    val sync = Json.obj(("openClose", Json.Bool(true)), ("change", Json.num(2)))
    Json.Obj([("positionEncoding", Json.str(encoding.name)), ("textDocumentSync", sync)] ++ provides)

  private context(cancelled: Atomic[bool], token: Option[ProgressToken]) -> Context =
    Context(out, encoding, client, documents.with(m -> m), cancelled, token)

// What a handler is given beside its params: the documents open when its message arrived, the
// position encoding agreed, what the client said at `initialize`, whether the request has been
// cancelled, and the way to send the client notifications and progress.
class Context(
    private val out: Channel[Option[string]],
    val encoding: PositionEncoding,
    val client: InitializeParams,
    val documents: HashMap[string, TextDocument],
    private val cancelled: Atomic[bool],
    val workDoneToken: Option[ProgressToken]
)
  // The open document at `uri`, as it was when the message being handled arrived.
  document(uri: string) -> Option[TextDocument] = documents.get(uri)

  // Whether the client has cancelled the request; its answer has gone, and whatever the handler
  // answers now is dropped, so a long handler looks here and stops early.
  isCancelled -> bool = cancelled.load()

  // Sends the client a notification of `method`.
  notify[P: JsonEncoder](method: string, params: P) = out.send(Some(notificationText(method, params)))

  // Sends `window/logMessage`: `kind` 1 is an error, 2 a warning, 3 information and 4 a log line.
  log(message: string, kind: int = 4) = notify("window/logMessage", LogMessageParams(kind, message))

  // Publishes `diagnostics` for the document at `uri`.
  publishDiagnostics(uri: string, diagnostics: Vector[Diagnostic], version: Option[int] = None) =
    notify("textDocument/publishDiagnostics", PublishDiagnosticsParams(uri, diagnostics, version))

  // Reports work-done progress on the request's token: `begin`, then any number of `report`s, then
  // `end`. A request whose params gave no `workDoneToken` reports nothing.
  beginProgress(title: string, message: Option[string] = None, percentage: Option[int] = None) =
    progress(WorkDoneProgress("begin", Some(title), message, percentage))

  reportProgress(message: Option[string] = None, percentage: Option[int] = None) =
    progress(WorkDoneProgress("report", None, message, percentage))

  endProgress(message: Option[string] = None) = progress(WorkDoneProgress("end", None, message, None))

  private progress(value: WorkDoneProgress) = workDoneToken match
    Some(t) -> notify("$/progress", ProgressParams(t, value))
    None -> ()
