module tests

// The arguments an editor starts a server with, read as the connection to make.
import dev.avinlang.lsp.{Connection, connectionOf}

@test("--pipe and --socket, with = or as the next argument, and --port as --socket")
connections()
  assertEq(connectionOf(["--pipe=/tmp/x.sock"]), Ok(Connection.Pipe("/tmp/x.sock")))
  assertEq(connectionOf(["--pipe", "/tmp/y"]), Ok(Connection.Pipe("/tmp/y")))
  assertEq(connectionOf(["--socket=5007"]), Ok(Connection.Socket(5007)))
  assertEq(connectionOf(["--socket", "1"]), Ok(Connection.Socket(1)))
  assertEq(connectionOf(["--port=65535"]), Ok(Connection.Socket(65535)))
  assertEq(connectionOf(["--clientProcessId=42", "--pipe=/p"]), Ok(Connection.Pipe("/p")))
  assertEq(connectionOf(["--pipe=/a=b"]), Ok(Connection.Pipe("/a=b")))
  assertEq(connectionOf(["--pipe=/first", "--socket=9"]), Ok(Connection.Socket(9)))

@test("--stdio, alone, among other arguments, the last of several connections counting, and no connection named")
stdioConnections()
  assertEq(connectionOf(["--stdio"]), Ok(Connection.Stdio))
  assertEq(connectionOf([]), Ok(Connection.Stdio))
  assertEq(connectionOf(["--clientProcessId=42"]), Ok(Connection.Stdio))
  assertEq(connectionOf(["--stdio=yes"]), Ok(Connection.Stdio))
  assertEq(connectionOf(["--clientProcessId=42", "--stdio"]), Ok(Connection.Stdio))
  assertEq(connectionOf(["--stdio", "--clientProcessId", "42"]), Ok(Connection.Stdio))
  assertEq(connectionOf(["--pipe=/p", "--stdio"]), Ok(Connection.Stdio))
  assertEq(connectionOf(["--stdio", "--socket=9"]), Ok(Connection.Socket(9)))
  assertEq(connectionOf(["--stdio", "--stdio"]), Ok(Connection.Stdio))

@test("a name with no value, and a port out of range")
badConnections()
  assertEq(connectionOf(["--pipe"]), Err("--pipe names nothing"))
  assertEq(connectionOf(["--socket"]), Err("--socket names nothing"))
  assertEq(connectionOf(["--socket=0"]), Err("'0' is not a port"))
  assertEq(connectionOf(["--socket=65536"]), Err("'65536' is not a port"))
  assertEq(connectionOf(["--socket=x"]), Err("'x' is not a port"))
  assertEq(connectionOf(["--socket=-1"]), Err("'-1' is not a port"))
